from collections import deque

class Monster:
    def __init__(self, name: str, health: int, attack: int):
        self.name = name
        self.health = health
        self.attack = attack

    def is_alive(self) -> bool:
        """Return whether this monster currently has more than 0 health."""
        return self.health > 0

    def take_damage(self, damage: int) -> None:
        """Subtract damage from health."""
        self.health -= damage


class Team:
    def __init__(self, name: str, monsters: list[Monster]):
        self.name = name
        self.monsters = monsters  # Keep ordered list

    def get_first_alive(self) -> Monster | None:
        """Find the earliest surviving monster in order, or None if all are defeated."""
        for monster in self.monsters:
            if monster.is_alive():
                return monster
        return None

    def is_defeated(self) -> bool:
        """Return True if no monsters on this team remain alive."""
        return self.get_first_alive() is None


def battle(team_a: Team, team_b: Team) -> list[str]:
    """Simulate battle and return event log strings."""
    event_log = [f"Battle begins: {team_a.name} vs {team_b.name}"]
    
    # Track current attacker and defender teams
    attacker_team, defender_team = team_a, team_b

    while not team_a.is_defeated() and not team_b.is_defeated():
        attacker = attacker_team.get_first_alive()
        defender = defender_team.get_first_alive()

        if not attacker or not defender:
            break

        # Execute attack
        defender.take_damage(attacker.attack)

        # Log attack event
        if defender.is_alive():
            event_log.append(
                f"{attacker.name} attacks {defender.name} for {attacker.attack} damage. "
                f"{defender.name} has {defender.health} HP remaining."
            )
        else:
            event_log.append(
                f"{attacker.name} attacks {defender.name} for {attacker.attack} damage. "
                f"{defender.name} is eliminated!"
            )

        # Swap attacker and defender for the next turn
        attacker_team, defender_team = defender_team, attacker_team

    # Declare winner
    winner = team_a if not team_a.is_defeated() else team_b
    event_log.append(f"Battle ends: {winner.name} wins!")

    return event_log

